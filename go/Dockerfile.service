FROM golang:1.24-bookworm@sha256:1a6d4452c65dea36aac2e2d606b01b4a029ec90cc1ae53890540ce6173ea77ac AS builder
RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler && rm -rf /var/lib/apt/lists/* \
    && go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.5
WORKDIR /src/go
COPY go/go.mod go/go.sum ./
RUN go mod download
COPY proto /src/proto
COPY contracts /src/contracts
COPY examples /src/examples
COPY tests/fixtures /src/tests/fixtures
COPY go /src/go
RUN mkdir -p generated && protoc -I../proto --go_out=generated --go_opt=paths=source_relative ../proto/inteagle_vdm_mqtt_v1.proto \
    && go test ./... \
    && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/vdm-service ./cmd/service \
    && mkdir -p /out/data && chmod 700 /out/data
FROM gcr.io/distroless/static-debian12:nonroot@sha256:f5b485ea962d9bd1186b2f6b3a061191539b905b82ec395de78cbfae51f20e35
COPY --from=builder /out/vdm-service /vdm-service
COPY --from=builder /src/contracts /contracts
COPY --from=builder --chown=nonroot:nonroot /out/data /data
ENV VDM_SERVICE_CONFIG=/contracts/config.example.json VDM_DATA_DIR=/data
EXPOSE 8080
ENTRYPOINT ["/vdm-service"]
