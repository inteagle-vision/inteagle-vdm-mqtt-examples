
FROM maven:3.9.9-eclipse-temurin-21@sha256:3a4ab3276a087bf276f79cae96b1af04f53731bec53fb2e651aca79e4b10211e AS builder

WORKDIR /src
COPY java/pom.xml /src/java/pom.xml
WORKDIR /src/java
RUN --mount=type=cache,target=/root/.m2 \
    mvn --batch-mode --no-transfer-progress dependency:go-offline

WORKDIR /src
COPY contracts /src/contracts
COPY tests/fixtures /src/tests/fixtures
COPY proto /src/proto
COPY examples /src/examples
COPY java/src /src/java/src
WORKDIR /src/java
RUN --mount=type=cache,target=/root/.m2 \
    mvn --batch-mode --no-transfer-progress package

FROM eclipse-temurin:21-jre@sha256:10c64ccda26cc3505fcf09b4b766ae7a530492e63bf5ec89b7217aa421d18a85
WORKDIR /app
COPY --from=builder /src/java/target/vdm-mqtt-consumer-1.0.0-service.jar /app/service.jar
COPY contracts/config.example.json /app/config.example.json
ENV VDM_SERVICE_CONFIG=/app/config.example.json VDM_DATA_DIR=/data VDM_HTTP_HOST=0.0.0.0 VDM_HTTP_PORT=8080
EXPOSE 8080
VOLUME ["/data"]
ENTRYPOINT ["java", "-jar", "/app/service.jar"]
