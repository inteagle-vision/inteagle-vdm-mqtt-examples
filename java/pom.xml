<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.inteagle.vdm</groupId>
  <artifactId>vdm-mqtt-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Inteagle VDM MQTT Parent</name>
  <description>Java SDK and Spring Boot integration for Inteagle VDM devices over MQTT.</description>
  <url>https://github.com/inteagle-vision/inteagle-vdm-mqtt-examples</url>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>inteagle</id>
      <name>Inteagle Team</name>
      <email>dev@inteagle.com</email>
      <organization>Inteagle</organization>
      <organizationUrl>https://github.com/inteagle-vision</organizationUrl>
    </developer>
  </developers>
  <modules>
    <module>sdk</module>
    <module>mqtt-paho</module>
    <module>spring-boot-autoconfigure</module>
    <module>spring-boot-starter</module>
    <module>example</module>
  </modules>
  <scm>
    <connection>scm:git:https://github.com/inteagle-vision/inteagle-vdm-mqtt-examples.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/inteagle-vision/inteagle-vdm-mqtt-examples.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/inteagle-vision/inteagle-vdm-mqtt-examples</url>
  </scm>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.5.16</spring-boot.version>
    <protobuf.version>4.36.2</protobuf.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-bom</artifactId>
        <version>2.26.1</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- SDK 的 Jackson 2 类型独立于 Boot 4 默认 Jackson 3；统一 2.x 的 core/annotations/databind 版本。 -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>2.23.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java-util</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.paho</groupId>
        <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
        <version>1.2.5</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <targetPath>META-INF</targetPath>
        <directory>${project.basedir}/../../</directory>
        <includes>
          <include>LICENSE</include>
        </includes>
      </resource>
    </resources>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.4</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.4</version>
        <configuration>
          <lineEndings>UNIX</lineEndings>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <!-- 固定 JDK 17 可运行的版本，17/21 构建使用相同格式规则；不格式化生成代码。 -->
            <googleJavaFormat>
              <version>1.28.0</version>
            </googleJavaFormat>
            <removeUnusedImports/>
          </java>
          <pom>
            <includes>
              <include>pom.xml</include>
              <include>**/pom.xml</include>
            </includes>
            <excludes>
              <exclude>**/target/**</exclude>
            </excludes>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
              <nrOfIndentSpace>2</nrOfIndentSpace>
            </sortPom>
          </pom>
          <formats>
            <format>
              <includes>
                <include>**/*.md</include>
                <include>**/*.yml</include>
                <include>*.sh</include>
              </includes>
              <excludes>
                <exclude>**/target/**</exclude>
              </excludes>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </format>
          </formats>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- 仅发布构建启用签名和附件；普通 install 不依赖 GPG 或 Central 账号。 -->
    <profile>
      <id>release</id>
      <properties>
        <vdm.publish.skip>false</vdm.publish.skip>
        <central.skipUpload>true</central.skipUpload>
        <gpg.skip>false</gpg.skip>
        <maven.javadoc.skip>false</maven.javadoc.skip>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <configuration>
              <skipSource>${vdm.publish.skip}</skipSource>
            </configuration>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <configuration>
              <skip>${maven.javadoc.skip}</skip>
              <encoding>UTF-8</encoding>
              <doclint>all,-missing</doclint>
              <notimestamp>true</notimestamp>
              <failOnError>true</failOnError>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadoc</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <configuration>
              <skip>${gpg.skip}</skip>
              <bestPractices>true</bestPractices>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <goals>
                  <goal>sign</goal>
                </goals>
                <phase>verify</phase>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <skipPublishing>${vdm.publish.skip}</skipPublishing>
              <!-- 默认只生成本地 bundle；显式关闭 skipUpload 才上传，上传后仍需手动发布。 -->
              <skipUpload>${central.skipUpload}</skipUpload>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
